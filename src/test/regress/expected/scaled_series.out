-- Basic test with default SCALE_FACTOR=1
SELECT * FROM scaled_series(1, 5);
 scaled_series 
--------------
            1
            2
            3
            4
            5
(5 rows)

SELECT * FROM scaled_series(1, 5, 1);
 scaled_series 
--------------
            1
            2
            3
            4
            5
(5 rows)

