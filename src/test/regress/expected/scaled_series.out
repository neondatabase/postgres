-- Test nested query case to verify complexity isn't exponential
\set SCALE_FACTOR 2
SELECT count(*) FROM 
  (SELECT a FROM scaled_series(1, 5) a) a,
  (SELECT b FROM scaled_series(1, 5) b) b;
 count 
-------
    81
(1 row)

-- Reset SCALE_FACTOR to default
\set SCALE_FACTOR 1
